      <section id="products" class="content-section">
        <p class="section__text__p1">Technical Work</p>
        <h2 class="title">Products</h2>
        <div class="project-grid">
          <article class="details-container color-container project-card">
            <div class="project-image-wrap">
              <img
                src="./assets/project-casetrace.png"
                alt="CaseTrace computer-use discovery and deterministic replay"
                class="project-img"
              />
            </div>
            <div class="project-content">
              <p class="eyebrow">
                Computer Use · AI Agents · Browser Automation
              </p>

              <h3 class="experience-sub-title project-title">
                CaseTrace
              </h3>

              <p class="project-description">
                Built a computer-use prototype that discovers a bounded browser
                workflow on a synthetic bank, compiles it into a typed capability,
                and replays it deterministically with different inputs, including
                human handoff and hard checkpoint failure.
              </p>

              <div class="project-outcomes">
                <p class="project-outcomes-title">Impact</p>
                <ul>
                  <li class="project-outcome">
                    Designed a browser-automation agent that turns local Ollama-guided
                    runs on a synthetic banking app into 50+ typed
                    payment-investigation workflows, resulting in 90% lower cost per
                    investigation, by replaying each one in Playwright with zero LLM
                    calls.
                  </li>
                  <li class="project-outcome">
                    Added 20+ policy checks and a human handoff for high-risk payment
                    cases, resulting in 30+ risky actions stopped in testing, by
                    enforcing hard checkpoints before any irreversible step.
                  </li>
                </ul>
              </div>

              <div class="tag-list">
                <span>Computer Use</span>
                <span>AI Agents</span>
                <span>Playwright</span>
                <span>Ollama</span>
                <span>Deterministic Replay</span>
              </div>

              <div class="project-links">
                <a
                  href="https://github.com/Sukanya41455/CaseTrace"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-btn"
                >
